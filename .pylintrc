#
# Project pylint configuration (design §14, code-style §1). Target: 10.00/10.
# The reason for every setting below is also in README "Static analysis: pylint settings".

[MAIN]
py-version=3.14
jobs=0
ignore=.venv,venv,reports,logs,.git,.idea

[BASIC]
# No short names anywhere: at least 3 characters, no exceptions list (project rule: no i, e, x).
good-names=
bad-names=
variable-rgx=[a-z_][a-z0-9_]{2,}$
argument-rgx=[a-z_][a-z0-9_]{2,}$
inlinevar-rgx=[a-z_][a-z0-9_]{2,}$
class-attribute-rgx=([A-Za-z_][A-Za-z0-9_]{2,}|id)$
# "id" only as an attribute mirroring a third-party wire contract (code-style §1).
attr-rgx=([a-z_][a-z0-9_]{2,}|id)$
const-rgx=(_?[A-Z][A-Z0-9_]{2,}|__[a-z0-9_]+__)$
# Test callables follow EMI_<TOOL>_<LAYER>_<ID>_<behavior> (testing-standards), the tool part may be several
# words (EMI_TEST_BROKER_UNIT_130001_...), the ID has at least 6 digits (TestRail); everything else snake_case.
function-rgx=([a-z_][a-z0-9_]{2,}|EMI_[A-Z0-9]+(_[A-Z0-9]+)+_[0-9]{6,}_[a-z0-9_]+)$
method-rgx=([a-z_][a-z0-9_]{2,}|EMI_[A-Z0-9]+(_[A-Z0-9]+)+_[0-9]{6,}_[a-z0-9_]+)$
class-rgx=[A-Z_][a-zA-Z0-9]+$

[FORMAT]
# 110 forced awkward wrapping of typed signatures and keyword messages; 120 still fits side by side in review.
max-line-length=120

[DESIGN]
# Constructors take an injectable clock, sleeper and factories so unit tests can simulate time and servers.
max-args=8
max-positional-arguments=6
# Settings objects hold one field per documented option.
max-attributes=12
max-returns=8
# Data classes and protocols have no methods by design.
min-public-methods=0

[MESSAGES CONTROL]
# Nothing is disabled globally; each exception is a commented, line-level disable (README lists them).
disable=
